---
import { site } from '../config/site';

interface Props {
  eyebrow?: string;
  title?: string;
  body?: string;
}

const {
  eyebrow = 'A tailored first workflow',
  title = 'Bring the operating question.',
  body = 'Start with the context, decision, and owner that should shape the demonstration.',
} = Astro.props;
---

<section class="section section--moss page-cta">
  <div class="container--content page-cta__grid">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
    </div>
    <div>
      <p class="deck">{body}</p>
      <a class="button button--primary" href={site.demoPath}>Book a tailored demo</a>
    </div>
  </div>
</section>

<style>
  .page-cta__grid {
    display: grid;
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: end;
  }

  .page-cta h2 {
    max-width: 12ch;
    margin-bottom: 0;
  }

  .page-cta .deck {
    margin-bottom: 2rem;
  }

  @media (min-width: 48rem) {
    .page-cta__grid { grid-template-columns: 1.2fr 0.8fr; }
  }
</style>
