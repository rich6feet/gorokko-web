---
import { site } from '../config/site';

interface Props {
  eyebrow?: string;
  title?: string;
  body?: string;
}

const {
  eyebrow = 'Start with one daily headache',
  title = 'Show us where work gets stuck.',
  body = 'Bring one question your team keeps asking. We’ll show you how Rokko could help.',
} = Astro.props;
---

<section class="section section--moss page-cta">
  <div class="container--content page-cta__grid">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
    </div>
    <div>
      <p class="deck">{body}</p>
      <a class="button button--primary" href={site.demoPath}>Show me Rokko</a>
    </div>
  </div>
</section>

<style>
  .page-cta__grid {
    display: grid;
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: end;
  }

  .page-cta h2 {
    max-width: 12ch;
    margin-bottom: 0;
  }

  .page-cta .deck {
    margin-bottom: 2rem;
  }

  @media (min-width: 48rem) {
    .page-cta__grid { grid-template-columns: 1.2fr 0.8fr; }
  }
</style>
