---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <a class="site-footer__logo" href="/" aria-label="Rokko home">
        <img src="/brand/gorokko-03b-wordmark-color.svg" width="438" height="104" alt="GO ROKKO" />
      </a>
      <p>See what needs attention. Make the call.</p>
    </div>
    <div class="site-footer__grid">
      <nav aria-label="Product">
        <h2>Rokko</h2>
        <a href="/product/">How it works</a>
        <a href="/use-cases/">Ways to use it</a>
        <a href="/security/">Your data</a>
        <a href="/demo/">See a demo</a>
      </nav>
      <nav aria-label="Company">
        <h2>Company</h2>
        <a href="/about/">About</a>
        <a href="/resources/">Guides</a>
        <a href="/status/">Is Rokko running?</a>
      </nav>
      <nav aria-label="Legal">
        <h2>Legal</h2>
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
        <a href="/sms-terms/">SMS terms</a>
      </nav>
    </div>
    <div class="site-footer__bottom">
      <span>© {year} Rokko.</span>
      <span>You stay in charge.</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(3.5rem, 7vw, 7rem) 2rem;
    color: var(--grk-text);
    background: var(--grk-bg-surface);
    border-top: 1px solid var(--grk-border);
  }

  .site-footer__top {
    display: grid;
    gap: 1.5rem;
    padding-bottom: clamp(3rem, 6vw, 6rem);
    border-bottom: 1px solid var(--grk-border);
  }

  .site-footer__logo {
    display: block;
    width: min(15rem, 65vw);
  }

  .site-footer__logo img {
    transition: filter var(--grk-duration-state) var(--grk-ease-standard);
  }

  .site-footer__top p {
    margin: 0;
    font-family: var(--grk-font-serif);
    font-size: clamp(1.5rem, 3vw, 2.35rem);
    line-height: 1.1;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    padding-block: 3rem;
  }

  .site-footer nav {
    display: grid;
    align-content: start;
    gap: 0.5rem;
  }

  .site-footer nav h2 {
    margin-bottom: 0.75rem;
    color: var(--grk-text-muted);
    font-family: var(--grk-font-mono);
    font-size: var(--grk-text-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .site-footer nav a {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    font-size: 0.92rem;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    color: var(--grk-text-muted);
    border-top: 1px solid var(--grk-border);
    font-family: var(--grk-font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  :global(html[data-theme='dark']) .site-footer__logo img {
    filter: brightness(0) invert(1);
  }

  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme])) .site-footer__logo img {
      filter: brightness(0) invert(1);
    }
  }

  @media (min-width: 48rem) {
    .site-footer__top {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }

    .site-footer__top p {
      justify-self: end;
      text-align: right;
    }

    .site-footer__grid {
      grid-template-columns: 2fr repeat(3, 1fr);
    }

    .site-footer__grid::before {
      content: '';
    }
  }
</style>
