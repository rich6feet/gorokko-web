---
// GHL booking calendar embed. src is set by Attribution.astro so the ad touch rides along.
interface Props {
  url: string;
  title: string;
  height?: number;
}

const { url, title, height = 760 } = Astro.props;
const frameId = `ghl-cal-${new URL(url).pathname.split('/').pop()}`;
---

<div class="ghl-calendar">
  <div class="ghl-calendar__shell">
    <iframe
      data-ghl-embed
      data-src={url}
      id={frameId}
      title={title}
      width="100%"
      height={height}
      style={`min-height:${height}px`}
      loading="eager"
      allow="payment"
    ></iframe>
    <noscript>
      <p class="ghl-calendar__noscript"><a href={url}>Open the booking calendar</a></p>
    </noscript>
  </div>
  <p class="ghl-calendar__fallback">
    Calendar not loading? <a href={url} target="_blank" rel="noopener noreferrer">Open it in a new tab</a>.
  </p>
</div>

<script is:inline defer src="https://links.serviceosllc.com/js/form_embed.js"></script>

<style>
  .ghl-calendar__shell {
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--grk-border);
    border-radius: var(--grk-radius-panel);
    box-shadow: var(--grk-shadow-interactive);
  }

  .ghl-calendar__shell iframe {
    display: block;
    width: 100%;
    border: 0;
    border-radius: inherit;
  }

  .ghl-calendar__noscript {
    margin: 0;
    padding: 2rem;
    color: #111515;
  }

  .ghl-calendar__fallback {
    margin: 0.85rem 0 0;
    color: var(--grk-text-muted);
    font-size: 0.9rem;
    text-align: center;
  }

  @media (max-width: 36rem) {
    .ghl-calendar__shell iframe { min-height: 860px !important; }
  }
</style>
