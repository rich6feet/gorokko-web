---
import { navigation, site } from '../config/site';

const normalizePath = (path: string) => path === '/' ? path : path.replace(/\/+$/, '');
const currentPath = normalizePath(Astro.url.pathname);
const isCurrent = (href: string) => {
  const itemPath = normalizePath(href);
  return itemPath === '/' ? currentPath === '/' : currentPath === itemPath || currentPath.startsWith(`${itemPath}/`);
};
---

<header class="site-header">
  <div class="site-header__inner container">
    <a class="site-header__logo" href="/" aria-label="Rokko home">
      <img src="/brand/gorokko-03b-lockup-color.svg" width="520" height="116" alt="GO ROKKO" />
    </a>
    <nav id="site-navigation" class="site-nav" aria-label="Primary">
      <ul>
        {navigation.map((item) => (
          <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
      <a class="button button--primary site-nav__cta" href={site.demoPath}>Show me Rokko</a>
    </nav>
    <div class="site-header__controls">
      <button class="theme-toggle" type="button" aria-pressed="false">
        <span class="sr-only" data-theme-label>Switch to dark theme</span>
        <span class="theme-toggle__track" aria-hidden="true">
          <span class="theme-toggle__thumb">
            <span class="theme-toggle__sun">☀</span>
            <span class="theme-toggle__moon">☾</span>
          </span>
        </span>
      </button>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation">
        <span class="menu-toggle__label">Menu</span>
        <span class="menu-toggle__bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<script>
  type RokkoTheme = 'light' | 'dark';
  type ThemeApi = {
    get: () => RokkoTheme;
    set: (theme: RokkoTheme, source?: string) => RokkoTheme;
    toggle: (source?: string) => RokkoTheme;
    useSystem: () => RokkoTheme;
  };

  const root = document.documentElement;
  const header = document.querySelector<HTMLElement>('.site-header');
  const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menuLabel = menuToggle?.querySelector<HTMLElement>('.menu-toggle__label');
  const navigation = document.querySelector<HTMLElement>('#site-navigation');
  const themeToggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const themeLabel = themeToggle?.querySelector<HTMLElement>('[data-theme-label]');
  const desktopViewport = window.matchMedia('(min-width: 62rem)');

  const syncThemeToggle = () => {
    const isDark = root.dataset.theme === 'dark';
    const label = isDark ? 'Switch to light theme' : 'Switch to dark theme';
    themeToggle?.setAttribute('aria-pressed', String(isDark));
    themeToggle?.setAttribute('title', label);
    if (themeLabel) themeLabel.textContent = label;
  };

  themeToggle?.addEventListener('click', () => {
    const themeApi = (window as Window & { __rokkoTheme?: ThemeApi }).__rokkoTheme;
    if (themeApi) themeApi.toggle('header');
    else {
      const theme: RokkoTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = theme;
      window.dispatchEvent(new CustomEvent('rokko:themechange', { detail: { theme, source: 'header' } }));
    }
    syncThemeToggle();
  });

  window.addEventListener('rokko:themechange', syncThemeToggle);
  syncThemeToggle();

  const setMenuState = (open: boolean, restoreFocus = false) => {
    menuToggle?.setAttribute('aria-expanded', String(open));
    header?.classList.toggle('is-open', open);
    document.body.classList.toggle('nav-open', open && !desktopViewport.matches);
    if (menuLabel) menuLabel.textContent = open ? 'Close' : 'Menu';
    if (desktopViewport.matches) navigation?.removeAttribute('aria-hidden');
    else navigation?.setAttribute('aria-hidden', String(!open));
    if (restoreFocus) menuToggle?.focus();
  };

  menuToggle?.addEventListener('click', () => {
    setMenuState(menuToggle.getAttribute('aria-expanded') !== 'true');
  });

  navigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuState(false)));
  document.addEventListener('pointerdown', (event) => {
    if (menuToggle?.getAttribute('aria-expanded') !== 'true') return;
    if (event.target instanceof Node && !header?.contains(event.target)) setMenuState(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menuToggle?.getAttribute('aria-expanded') === 'true') setMenuState(false, true);
  });
  desktopViewport.addEventListener('change', () => setMenuState(false));
  setMenuState(false);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--grk-navbar-height);
    color: var(--grk-text);
    background: var(--grk-header-bg);
    border-bottom: 1px solid var(--grk-border);
    backdrop-filter: blur(16px) saturate(125%);
  }

  .site-header__inner {
    display: flex;
    height: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .site-header__logo {
    display: flex;
    min-width: 10.5rem;
    min-height: 2.75rem;
    align-items: center;
    flex-shrink: 0;
  }

  .site-header__logo img {
    width: 11.25rem;
    height: auto;
    transform-origin: 25% 50%;
    transition: filter var(--grk-duration-state) var(--grk-ease-standard);
  }

  .site-header__logo:hover img,
  .site-header__logo:focus-visible img {
    animation: logo-nod 520ms var(--grk-ease-standard);
  }

  .site-header__controls {
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }

  .theme-toggle,
  .menu-toggle {
    display: inline-flex;
    min-width: 2.75rem;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    color: var(--grk-text);
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .theme-toggle {
    padding: 0.35rem;
    border-radius: 999px;
  }

  .theme-toggle:active .theme-toggle__track {
    transform: scale(0.96);
  }

  .theme-toggle__track {
    position: relative;
    width: 2.75rem;
    height: 1.55rem;
    padding: 0.15rem;
    background: var(--grk-bg-subtle);
    border: 1px solid var(--grk-border-strong);
    border-radius: 999px;
    transition:
      transform var(--grk-duration-control) var(--grk-ease-standard),
      background-color var(--grk-duration-state) var(--grk-ease-standard),
      border-color var(--grk-duration-state) var(--grk-ease-standard);
  }

  .theme-toggle__thumb {
    position: relative;
    display: grid;
    width: 1.12rem;
    height: 1.12rem;
    place-items: center;
    overflow: hidden;
    color: var(--grk-action-text);
    background: var(--grk-action);
    border-radius: 50%;
    transform: translateX(0);
    transition:
      transform var(--grk-duration-state) var(--grk-ease-overshoot),
      color var(--grk-duration-state) var(--grk-ease-standard),
      background-color var(--grk-duration-state) var(--grk-ease-standard);
  }

  .theme-toggle__sun,
  .theme-toggle__moon {
    position: absolute;
    font-size: 0.76rem;
    line-height: 1;
    transition:
      opacity var(--grk-duration-control) var(--grk-ease-standard),
      transform var(--grk-duration-state) var(--grk-ease-overshoot);
  }

  .theme-toggle__moon {
    opacity: 0;
    transform: rotate(-60deg) scale(0.55);
  }

  :global(html[data-theme='dark']) .theme-toggle__thumb {
    transform: translateX(1.18rem);
  }

  :global(html[data-theme='dark']) .theme-toggle__sun {
    opacity: 0;
    transform: rotate(70deg) scale(0.55);
  }

  :global(html[data-theme='dark']) .theme-toggle__moon {
    opacity: 1;
    transform: rotate(0) scale(1);
  }

  :global(html[data-theme='dark']) .site-header__logo img {
    filter: brightness(0) invert(1);
  }

  .menu-toggle {
    min-width: 3.75rem;
    gap: 0.55rem;
    padding: 0;
  }

  .menu-toggle__label {
    font-size: 0.82rem;
    font-weight: 650;
  }

  .menu-toggle__bars,
  .menu-toggle__bars::after {
    display: block;
    width: 1rem;
    height: 1px;
    content: '';
    background: currentColor;
    transition: transform var(--grk-duration-control) var(--grk-ease-standard);
  }

  .menu-toggle__bars::after {
    transform: translateY(0.35rem);
  }

  .is-open .menu-toggle__bars {
    transform: translateY(0.17rem) rotate(45deg);
  }

  .is-open .menu-toggle__bars::after {
    transform: rotate(-90deg);
  }

  .site-nav {
    position: fixed;
    inset: var(--grk-navbar-height) 0 auto;
    max-height: calc(100dvh - var(--grk-navbar-height));
    padding: 1.25rem 1rem 1.5rem;
    overflow-y: auto;
    visibility: hidden;
    opacity: 0;
    background: var(--grk-bg-surface);
    border-bottom: 1px solid var(--grk-border);
    box-shadow: var(--grk-shadow-elevated);
    pointer-events: none;
    transform: translate3d(0, -0.75rem, 0);
    transition:
      opacity var(--grk-duration-state) var(--grk-ease-standard),
      transform var(--grk-duration-state) var(--grk-ease-standard),
      visibility 0s linear var(--grk-duration-state),
      background-color var(--grk-duration-state) var(--grk-ease-standard),
      border-color var(--grk-duration-state) var(--grk-ease-standard);
  }

  .is-open .site-nav {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transform: translate3d(0, 0, 0);
    transition-delay: 0s;
  }

  .site-nav ul {
    display: grid;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }

  .site-nav li {
    border-bottom: 1px solid var(--grk-border);
  }

  .site-nav li a {
    position: relative;
    display: flex;
    min-height: 3.25rem;
    align-items: center;
    text-decoration: none;
  }

  .site-nav li a::after {
    position: absolute;
    right: 0;
    bottom: 0.48rem;
    left: 0;
    height: 1px;
    content: '';
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--grk-duration-state) var(--grk-ease-standard);
  }

  .site-nav li a:hover::after,
  .site-nav li a:focus-visible::after,
  .site-nav li a[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .site-nav li a[aria-current='page'] {
    color: var(--grk-action);
  }

  .site-nav__cta {
    width: 100%;
  }

  :global(body.nav-open) {
    overflow: hidden;
  }

  @keyframes logo-nod {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(0); }
    35% { transform: translate3d(0, -0.13rem, 0) rotate(-1.2deg); }
    68% { transform: translate3d(0, 0.04rem, 0) rotate(0.55deg); }
  }

  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme])) .theme-toggle__thumb {
      transform: translateX(1.18rem);
    }

    :global(html:not([data-theme])) .theme-toggle__sun {
      opacity: 0;
      transform: rotate(70deg) scale(0.55);
    }

    :global(html:not([data-theme])) .theme-toggle__moon {
      opacity: 1;
      transform: rotate(0) scale(1);
    }

    :global(html:not([data-theme])) .site-header__logo img {
      filter: brightness(0) invert(1);
    }
  }

  @media (min-width: 62rem) {
    .site-header__logo img {
      width: 13.2rem;
    }

    .site-header__controls {
      margin-left: 0.25rem;
    }

    .menu-toggle {
      display: none;
    }

    .site-nav {
      position: static;
      display: flex;
      max-height: none;
      margin-left: auto;
      padding: 0;
      overflow: visible;
      visibility: visible;
      align-items: center;
      gap: clamp(1rem, 2vw, 2rem);
      opacity: 1;
      background: transparent;
      border: 0;
      box-shadow: none;
      pointer-events: auto;
      transform: none;
      transition: none;
    }

    .site-nav ul {
      display: flex;
      margin: 0;
      gap: clamp(0.9rem, 1.7vw, 1.6rem);
    }

    .site-nav li {
      border: 0;
    }

    .site-nav li a {
      min-height: 2.75rem;
      font-size: 0.88rem;
      font-weight: 570;
    }

    .site-nav li a::after {
      bottom: 0.32rem;
    }

    .site-nav__cta {
      width: auto;
    }

    :global(body.nav-open) {
      overflow: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__logo:hover img,
    .site-header__logo:focus-visible img {
      animation: none;
    }
  }
</style>
