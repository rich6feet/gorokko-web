---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../config/site';
---

<BaseLayout
  title="Book your Rokko demo"
  description="Choose a time to talk through the daily work problem you want Rokko to help fix."
>
  <PageHero
    eyebrow="Pick a time"
    title="Choose a time that works."
    deck="You’ve told us where the work gets stuck. Now pick a time and we’ll walk through it with you."
    tone="moss"
  />

  <section class="section booking-calendar">
    <div class="container--content booking-calendar__layout">
      <div class="booking-calendar__intro">
        <p class="eyebrow">One last step</p>
        <h2>Put it on the calendar.</h2>
        <p>Choose the day and time that fits your schedule. We’ll use the details you already sent to keep the conversation focused.</p>
      </div>

      <div>
        <div class="booking-calendar__shell">
          <iframe
            src={site.calendarUrl}
            allow="payment"
            id="6goTW1YljKlb3R1fjnNd_1787147809080"
            title="Book a Rokko demo"
            width="100%"
            height="900"
            loading="eager"
          ></iframe>
        </div>
        <p class="booking-calendar__fallback">
          Calendar not loading? <a href={site.calendarUrl} target="_blank" rel="noopener noreferrer">Open it in a new tab</a>.
        </p>
      </div>
    </div>
  </section>

  <script is:inline defer src="https://links.serviceosllc.com/js/form_embed.js"></script>
</BaseLayout>

<style>
  .booking-calendar__layout {
    display: grid;
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: start;
  }

  .booking-calendar__intro {
    max-width: 34rem;
  }

  .booking-calendar__intro h2 {
    max-width: 10ch;
  }

  .booking-calendar__intro > p:last-child {
    color: var(--grk-text-muted);
    font-size: 1.05rem;
  }

  .booking-calendar__shell {
    min-height: 900px;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--grk-border);
    border-radius: var(--grk-radius-panel);
    box-shadow: var(--grk-shadow-interactive);
  }

  .booking-calendar__shell iframe {
    display: block;
    width: 100%;
    min-height: 900px;
    border: 0;
    border-radius: inherit;
  }

  .booking-calendar__fallback {
    margin: 1rem 0 0;
    color: var(--grk-text-muted);
    font-size: 0.9rem;
    text-align: center;
  }

  @media (min-width: 64rem) {
    .booking-calendar__layout {
      grid-template-columns: minmax(16rem, 0.55fr) minmax(34rem, 1.45fr);
    }

    .booking-calendar__intro {
      position: sticky;
      top: 7rem;
    }
  }

  @media (max-width: 36rem) {
    .booking-calendar__shell,
    .booking-calendar__shell iframe {
      min-height: 980px;
    }
  }
</style>
