---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductFlow from '../components/ProductFlow.astro';
import { site } from '../config/site';

const useCases = [
  { title: 'Your daily list', body: 'See what needs a yes, a no, or a closer look before the day gets away from you.', href: '/use-cases/owner-operations/' },
  { title: 'Customer calls and messages', body: 'Give each new customer a clear next step, even when the office is slammed.', href: '/use-cases/ai-receptionist/' },
  { title: 'Fast lead follow-up', body: 'See who needs a call back and who owns it before a good lead goes cold.', href: '/use-cases/speed-to-lead/' },
  { title: 'Missed appointments', body: 'Get a missed visit back on track without losing the notes or double-booking the crew.', href: '/use-cases/no-show-rescheduling/' },
  { title: 'Job handoff', body: 'Pass the promise, scope, and open questions from sales to the team doing the work.', href: '/use-cases/sales-to-operations/' },
];

const faqs = [
  { q: 'What does Rokko do?', a: 'Rokko helps home-service owners see what needs attention. It brings the job details and team replies into one place, then keeps the next step in front of the right person.' },
  { q: 'Will Rokko change a job without asking me?', a: 'The goal is simple: big changes wait for the right person to say yes. We set those rules with you before a test run starts.' },
  { q: 'Is Rokko just a chatbot?', a: 'No. You can talk to Rokko like a teammate, but the point is getting real work unstuck. It helps with follow-up, handoffs, and decisions—not small talk.' },
  { q: 'What software will Rokko work with?', a: 'We’re still confirming the first connections. We’ll list only the tools we have tested and are ready to support.' },
  { q: 'How much does it cost?', a: 'Public pricing is not final yet. We won’t make up plan names, fees, or limits just to fill a page.' },
];
---

<BaseLayout>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">An extra set of eyes for home-service teams</p>
        <h1>See what needs attention.<br /><span class="display-accent">Make the call.</span></h1>
        <p class="deck">
          Rokko helps you catch missed follow-ups, schedule problems, and jobs that need a decision. Ask a question in plain English. See the details. Nothing important moves until the right person says yes.
        </p>
        <div class="button-row">
          <a class="button button--primary" href={site.demoPath}>Show me Rokko</a>
          <a class="button button--secondary" href="#core-flow">See a sample workday</a>
        </div>
        <p class="hero__note">Sample screens only. No customer data.</p>
      </div>
      <div class="hero__visual">
        <figure class="hero__media">
          <img
            src="/assets/rokko-hero-contractor-workflow.webp"
            width="1440"
            height="960"
            alt="A home-service contractor checking the day’s work beside a service van"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
        <div class="hero__flow">
          <ProductFlow />
        </div>
      </div>
    </div>
  </section>

  <section class="boundary" aria-label="Rokko product boundary">
    <div class="container boundary__grid">
      <span>See the right job details</span>
      <span>You approve big changes</span>
      <span>Know what happened</span>
      <span>Built for service teams</span>
    </div>
  </section>

  <section class="section section--paper problem">
    <div class="container--content grid-2 problem__grid">
      <div>
        <p class="eyebrow">The daily headache</p>
        <h2>The answer is somewhere. Finding it <span class="display-accent">eats the morning.</span></h2>
      </div>
      <div class="problem__copy">
        <p class="deck">Jobs, calls, texts, notes, and schedules all live in different places. You open five tabs, ask three people, and still wonder if the answer is current.</p>
        <div class="rule"></div>
        <dl class="signal-list">
          <div><dt>01</dt><dd>Simple answers take too long to find.</dd></div>
          <div><dt>02</dt><dd>Follow-ups slip when nobody owns the next step.</dd></div>
          <div><dt>03</dt><dd>Software causes trouble when it acts without asking.</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section id="core-flow" class="section section--moss flow-section">
    <div class="container--content">
      <div class="flow-section__intro">
        <p class="eyebrow">How Rokko helps</p>
        <h2>Ask → Check → <span class="display-accent">Approve</span></h2>
        <p class="deck">Ask a real work question. Check what Rokko found. Approve the next step.</p>
      </div>
      <div class="flow-grid">
        <article>
          <span>01 / Ask</span>
          <h3>Ask it like you’d ask your office manager.</h3>
          <p>Ask about jobs, follow-ups, or the schedule. You don’t need special commands.</p>
        </article>
        <article>
          <span>02 / Check</span>
          <h3>See the details behind the answer.</h3>
          <p>Review the job notes and open questions in one place before you decide.</p>
        </article>
        <article>
          <span>03 / Approve</span>
          <h3>You make the call.</h3>
          <p>Approve the next step or hold it. Your crew can see what happened and what still needs work.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section layers">
    <div class="container--content">
      <div class="layers__heading">
        <div>
          <p class="eyebrow">Where it helps</p>
          <h2>Keep the office and field crew on the same page.</h2>
        </div>
        <p class="deck">Rokko does more than answer messages. It helps you spot stuck work and keep handoffs clear without taking over.</p>
      </div>
      <div class="grid-3">
        <article class="numbered-card">
          <span class="numbered-card__number">Area 01</span>
          <figure class="numbered-card__media">
            <img
              src="/assets/feature-daily-owner-list.webp"
              width="960"
              height="720"
              alt="A service business owner reviewing the day’s priorities on a tablet"
              loading="lazy"
              decoding="async"
            />
          </figure>
          <h3>Your daily list</h3>
          <p>See the jobs, customer issues, and choices that need your attention today.</p>
        </article>
        <article class="numbered-card">
          <span class="numbered-card__number">Area 02</span>
          <figure class="numbered-card__media">
            <img
              src="/assets/feature-customer-follow-up.webp"
              width="960"
              height="720"
              alt="An office dispatcher following up with a customer by phone"
              loading="lazy"
              decoding="async"
            />
          </figure>
          <h3>Customer follow-up</h3>
          <p>Keep calls and messages tied to the job so the next person knows what to do.</p>
        </article>
        <article class="numbered-card">
          <span class="numbered-card__number">Area 03</span>
          <figure class="numbered-card__media">
            <img
              src="/assets/feature-jobs-and-schedules.webp"
              width="960"
              height="720"
              alt="A field crew checking job details beside their service vehicle"
              loading="lazy"
              decoding="async"
            />
          </figure>
          <h3>Jobs and schedules</h3>
          <p>Catch missed visits, schedule gaps, and sales handoffs before they turn into callbacks.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--paper trace">
    <div class="container--content">
      <div class="grid-2 trace__top">
        <div>
          <p class="eyebrow">No mystery moves</p>
          <h2>See what happened and who made the call.</h2>
        </div>
        <p class="deck">Each step stays in view. If something looks off, you can see where it changed and who approved it.</p>
      </div>
      <ol class="event-trace">
        <li><span>08:42</span><strong>Question asked</strong><small>Work picked</small></li>
        <li><span>08:43</span><strong>Job details checked</strong><small>Notes shown</small></li>
        <li><span>08:44</span><strong>Your approval requested</strong><small>Waiting on you</small></li>
        <li><span>08:47</span><strong>Team sees the result</strong><small>Next step clear</small></li>
      </ol>
    </div>
  </section>

  <section class="section use-cases">
    <div class="container--content">
      <div class="use-cases__heading">
        <div>
          <p class="eyebrow">Ways to use it</p>
          <h2>Start where lost time already hurts.</h2>
        </div>
        <a class="text-link" href="/use-cases/">See all the ways Rokko can help</a>
      </div>
      <div class="use-case-list">
        {useCases.map((item, index) => (
          <a href={item.href}>
            <span>0{index + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            <strong aria-hidden="true">↗</strong>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--dark implementation">
    <div class="container--content">
      <div class="grid-2 implementation__intro">
        <div>
          <p class="eyebrow">Start small</p>
          <h2>Fix one daily headache first.</h2>
        </div>
        <p class="deck">Pick one problem your team already feels. Set the rules. Try it with real people. Add more only when it works.</p>
      </div>
      <ol class="implementation__steps">
        <li><span>01</span><strong>Pick</strong><p>Choose one question that slows your day down.</p></li>
        <li><span>02</span><strong>Set rules</strong><p>Decide what Rokko may prepare and who must approve it.</p></li>
        <li><span>03</span><strong>Try it</strong><p>Run a small test with your team and check the result.</p></li>
        <li><span>04</span><strong>Add more</strong><p>Bring in another task only after the first one earns its keep.</p></li>
      </ol>
    </div>
  </section>

  <section class="section proof">
    <div class="container--content grid-2 proof__grid">
      <div>
        <p class="eyebrow">Straight answers</p>
        <h2>No made-up numbers. No hidden actions.</h2>
      </div>
      <div>
        <p class="deck">We won’t post customer logos, savings claims, or case-study numbers until the customer and the facts back them up.</p>
        <p>When we share a result, you should be able to see what changed and how it was checked. That matters more than a big number with no story behind it.</p>
      </div>
    </div>
  </section>

  <section class="section section--paper security">
    <div class="container--content security__grid">
      <div class="security__mark" aria-hidden="true">
        <img src="/brand/gorokko-symbol-color.svg" alt="" width="160" height="160" />
      </div>
      <div>
        <p class="eyebrow">Your business data</p>
        <h2>Your customer list and money moves deserve tight control.</h2>
        <p class="deck">Worried a bad login could expose customer details or let someone change a job? Rokko is being built so people see only the work they need. Big changes wait for approval. If something looks wrong, you can check what happened.</p>
        <a class="text-link" href="/security/">See how we’re handling security</a>
      </div>
    </div>
  </section>

  <section class="section faq">
    <div class="container--content faq__grid">
      <div>
        <p class="eyebrow">Quick answers</p>
        <h2>What owners ask us first.</h2>
      </div>
      <div>
        {faqs.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--moss final-cta">
    <div class="container--content final-cta__grid">
      <div>
        <p class="eyebrow">Start with one headache</p>
        <h2>Show us where work<br /><span class="display-accent">keeps getting dropped.</span></h2>
      </div>
      <div>
        <p class="deck">Bring the part of your day that takes too many tabs, texts, and follow-ups. We’ll shape the demo around that.</p>
        <a class="button button--primary" href={site.demoPath}>Show me Rokko</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    overflow: hidden;
    padding-block: clamp(4rem, 9vw, 8.5rem);
  }

  .hero__grid {
    display: grid;
    gap: clamp(3.5rem, 8vw, 7rem);
    align-items: center;
  }

  .hero h1 {
    max-width: 12ch;
    margin-bottom: 2rem;
  }

  .hero .deck {
    max-width: 42rem;
    margin-bottom: 2rem;
  }

  .hero__note {
    margin: 1rem 0 0;
    color: var(--grk-text-muted);
    font-family: var(--grk-font-mono);
    font-size: 0.7rem;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .hero__visual {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    min-width: 0;
  }

  .hero__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 2;
    margin: 0;
    background: var(--grk-bg-surface);
    border: 1px solid var(--grk-border);
    border-radius: var(--grk-radius-media);
    box-shadow: var(--grk-shadow-interactive);
  }

  .hero__media::after,
  .numbered-card__media::after {
    position: absolute;
    inset: 0;
    content: '';
    background: var(--grk-image-scrim, transparent);
    pointer-events: none;
  }

  .hero__media img,
  .numbered-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__flow {
    margin: 0;
  }

  .boundary {
    border-block: 1px solid var(--grk-border);
  }

  .boundary__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .boundary__grid span {
    display: flex;
    min-height: 5rem;
    align-items: center;
    padding: 1rem;
    border-right: 1px solid var(--grk-border);
    border-bottom: 1px solid var(--grk-border);
    font-family: var(--grk-font-mono);
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.05em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .boundary__grid span:nth-child(2n) { border-right: 0; }
  .boundary__grid span:nth-last-child(-n + 2) { border-bottom: 0; }

  .problem__grid {
    align-items: start;
  }

  .problem h2 {
    max-width: 13ch;
  }

  .problem__copy {
    padding-top: 0.5rem;
  }

  .signal-list {
    margin: 0;
  }

  .signal-list div {
    display: grid;
    grid-template-columns: 3rem 1fr;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--grk-border);
  }

  .signal-list dt {
    color: var(--grk-action);
    font-family: var(--grk-font-mono);
    font-size: 0.72rem;
  }

  .signal-list dd {
    margin: 0;
  }

  .flow-section__intro {
    display: grid;
    max-width: 54rem;
    margin-bottom: clamp(3rem, 7vw, 7rem);
  }

  .flow-section__intro h2 {
    margin-bottom: 1.5rem;
  }

  .flow-grid {
    display: grid;
    gap: 1px;
    background: rgb(252 251 247 / 0.18);
    border: 1px solid rgb(252 251 247 / 0.18);
  }

  .flow-grid article {
    min-height: 21rem;
    padding: clamp(1.5rem, 3vw, 2.75rem);
    background: var(--grk-moss);
  }

  .flow-grid article > span {
    display: block;
    margin-bottom: clamp(4rem, 7vw, 7rem);
    color: var(--grk-success);
    font-family: var(--grk-font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  .flow-grid h3 {
    max-width: 16ch;
  }

  .flow-grid p {
    color: rgb(252 251 247 / 0.66);
  }

  .layers__heading,
  .use-cases__heading {
    display: grid;
    gap: 2rem;
    margin-bottom: clamp(3rem, 6vw, 6rem);
  }

  .numbered-card__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    margin: 0 0 1.5rem;
    background: var(--grk-bg-surface);
    border: 1px solid var(--grk-border);
    border-radius: calc(var(--grk-radius-panel) * 0.72);
  }

  .numbered-card__number {
    margin-bottom: 1rem;
  }

  .layers__heading h2,
  .use-cases__heading h2 {
    max-width: 13ch;
    margin-bottom: 0;
  }

  .trace__top {
    align-items: end;
    margin-bottom: clamp(3rem, 6vw, 6rem);
  }

  .trace h2 {
    max-width: 12ch;
  }

  .event-trace {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--grk-border);
    list-style: none;
  }

  .event-trace li {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 0.75rem;
    padding-block: 1.35rem;
    border-bottom: 1px solid var(--grk-border);
  }

  .event-trace span,
  .event-trace small {
    color: var(--grk-text-muted);
    font-family: var(--grk-font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  .event-trace small {
    grid-column: 2;
  }

  .use-cases__heading {
    align-items: end;
  }

  .use-case-list {
    border-top: 1px solid var(--grk-border);
  }

  .use-case-list a {
    position: relative;
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    gap: 1rem;
    align-items: start;
    min-height: 8rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--grk-border);
    text-decoration: none;
    transition: transform var(--grk-duration-control) var(--grk-ease-standard), background var(--grk-duration-control) var(--grk-ease-standard);
  }

  .use-case-list a:hover {
    transform: translateX(0.25rem);
    background: var(--grk-bg-surface);
  }

  .use-case-list span {
    color: var(--grk-action);
    font-family: var(--grk-font-mono);
    font-size: 0.72rem;
  }

  .use-case-list h3 {
    margin: 0;
  }

  .use-case-list p {
    grid-column: 2 / -1;
    margin: 0;
    color: var(--grk-text-muted);
  }

  .implementation__intro {
    align-items: end;
    margin-bottom: clamp(3rem, 6vw, 6rem);
  }

  .implementation h2 {
    max-width: 13ch;
  }

  .implementation__steps {
    display: grid;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgb(252 251 247 / 0.2);
    list-style: none;
  }

  .implementation__steps li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    padding-block: 1.5rem;
    border-bottom: 1px solid rgb(252 251 247 / 0.2);
  }

  .implementation__steps span {
    color: var(--grk-success);
    font-family: var(--grk-font-mono);
    font-size: 0.72rem;
  }

  .implementation__steps strong {
    font-size: 1.15rem;
  }

  .implementation__steps p {
    grid-column: 2;
    margin: 0.4rem 0 0;
    color: rgb(252 251 247 / 0.65);
  }

  .proof__grid {
    align-items: start;
  }

  .proof h2 {
    max-width: 10ch;
  }

  .security__grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .security__mark {
    display: grid;
    min-height: 22rem;
    place-items: center;
    background: var(--grk-bg-page);
    border: 1px solid var(--grk-border);
  }

  .security__mark img {
    width: clamp(7rem, 16vw, 11rem);
  }

  .security h2 {
    max-width: 13ch;
  }

  .faq__grid {
    display: grid;
    gap: clamp(3rem, 7vw, 7rem);
  }

  .faq h2 {
    max-width: 12ch;
  }

  .faq details {
    border-top: 1px solid var(--grk-border);
  }

  .faq details:last-child {
    border-bottom: 1px solid var(--grk-border);
  }

  .faq summary {
    position: relative;
    display: flex;
    min-height: 4.75rem;
    align-items: center;
    padding: 1rem 2.5rem 1rem 0;
    font-weight: 650;
    cursor: pointer;
    list-style: none;
  }

  .faq summary::-webkit-details-marker { display: none; }

  .faq summary::after {
    position: absolute;
    right: 0;
    content: '+';
    color: var(--grk-action);
    font-family: var(--grk-font-mono);
    font-size: 1.25rem;
  }

  .faq details[open] summary::after { content: '−'; }
  .faq details p { color: var(--grk-text-muted); }

  .final-cta__grid {
    display: grid;
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: end;
  }

  .final-cta h2 {
    max-width: 13ch;
    margin-bottom: 0;
  }

  .final-cta .deck {
    margin-bottom: 2rem;
  }

  @media (min-width: 48rem) {
    .boundary__grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .boundary__grid span {
      border-bottom: 0;
    }

    .boundary__grid span:nth-child(2n) { border-right: 1px solid var(--grk-border); }
    .boundary__grid span:last-child { border-right: 0; }

    .flow-grid { grid-template-columns: repeat(3, 1fr); }

    .layers__heading,
    .use-cases__heading {
      grid-template-columns: 1.35fr 0.65fr;
    }

    .event-trace li {
      grid-template-columns: 5rem 1fr auto;
      align-items: center;
    }

    .event-trace small { grid-column: auto; }

    .use-case-list a {
      grid-template-columns: 4rem 0.9fr 1.2fr auto;
      align-items: center;
    }

    .use-case-list p { grid-column: auto; }

    .implementation__steps { grid-template-columns: repeat(4, 1fr); }

    .implementation__steps li {
      grid-template-columns: 1fr;
      min-height: 17rem;
      padding: 1.5rem;
      border-right: 1px solid rgb(252 251 247 / 0.2);
    }

    .implementation__steps li:last-child { border-right: 0; }
    .implementation__steps strong { margin-top: 4rem; }
    .implementation__steps p { grid-column: 1; }

    .security__grid { grid-template-columns: 0.85fr 1.15fr; }
    .faq__grid { grid-template-columns: 0.8fr 1.2fr; }
    .final-cta__grid { grid-template-columns: 1.2fr 0.8fr; }
  }

  @media (min-width: 68rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.08fr) minmax(28rem, 0.92fr);
    }

  }

  :global(html[data-theme='dark']) .hero__media img,
  :global(html[data-theme='dark']) .numbered-card__media img {
    filter: brightness(0.86) saturate(0.9);
  }

  :global(html[data-theme='dark']) .security__mark img {
    filter: brightness(0) invert(1);
  }

  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme])) .hero__media img,
    :global(html:not([data-theme])) .numbered-card__media img {
      filter: brightness(0.86) saturate(0.9);
    }

    :global(html:not([data-theme])) .security__mark img {
      filter: brightness(0) invert(1);
    }
  }
</style>
