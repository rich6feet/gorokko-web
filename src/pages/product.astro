---
import BaseLayout from '../layouts/BaseLayout.astro';
import MessagingWorkspace from '../components/product/MessagingWorkspaceV2.astro';
---

<BaseLayout
  title="See how Rokko keeps work moving"
  description="Try a sample Rokko workroom for job follow-up, schedule checks, team replies, and owner approvals."
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline defer src="https://unpkg.com/lucide@1.32.0/dist/umd/lucide.min.js"></script>
  </Fragment>

  <section class="product-interface-page">
    <div class="container product-interface-intro">
      <div>
        <p class="eyebrow">See Rokko at work</p>
        <h1>Keep the office and field crew <span class="display-accent">on the same page.</span></h1>
      </div>
      <p class="deck">Ask what needs attention. Check the job details. Approve the next step without chasing people across texts and tabs. This is a sample workroom with no customer data.</p>
    </div>
    <div class="container">
      <MessagingWorkspace />
    </div>
  </section>
</BaseLayout>

<style>
  .product-interface-page {
    overflow: clip;
    padding-block: clamp(3.5rem, 7vw, 7rem);
  }

  .product-interface-intro {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  .product-interface-intro h1 {
    max-width: 13ch;
    margin-bottom: 0;
  }

  .product-interface-intro .deck {
    max-width: 38rem;
    margin-bottom: 0;
  }

  @media (min-width: 64rem) {
    .product-interface-intro {
      grid-template-columns: minmax(0, 1.15fr) minmax(22rem, 0.85fr);
    }

    .product-interface-intro .deck {
      justify-self: end;
    }
  }
</style>
