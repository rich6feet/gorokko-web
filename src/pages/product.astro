---
import BaseLayout from '../layouts/BaseLayout.astro';
import MessagingWorkspace from '../components/product/MessagingWorkspaceV2.astro';
---

<BaseLayout
  title="See how Rokko keeps work moving"
  description="Try a sample Rokko workroom for job follow-up, schedule checks, team replies, and owner approvals."
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline defer src="https://unpkg.com/lucide@1.32.0/dist/umd/lucide.min.js"></script>
  </Fragment>

  <section class="product-interface-page">
    <div class="container product-interface-intro">
      <div>
        <p class="eyebrow">See Rokko at work</p>
        <h1>Keep the office and field crew <span class="display-accent">on the same page.</span></h1>
      </div>
      <p class="deck">Ask what needs attention. Check the job details. Approve the next step without chasing people across texts and tabs. This is a sample workroom with no customer data.</p>
    </div>
    <div class="container">
      <MessagingWorkspace />
    </div>
  </section>
</BaseLayout>
