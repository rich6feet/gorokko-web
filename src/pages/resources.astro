---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FinalCta from '../components/FinalCta.astro';

const guides = [
  { number: '01', title: 'Pick one question', body: 'Start with a question you already ask every day. Write down what a useful answer must show.' },
  { number: '02', title: 'Decide who says yes', body: 'Choose what Rokko may prepare, what a person must approve, and when your team needs to step in.' },
  { number: '03', title: 'Know what good looks like', body: 'Pick a result your team can check. Skip big numbers that do not explain what really changed.' },
];
---

<BaseLayout
  title="Rokko guides — Start with one problem worth fixing"
  description="Three plain steps for choosing where Rokko may help your home-service team first."
>
  <PageHero
    eyebrow="Guides"
    title="Start with the headache your team already knows."
    deck="These quick notes help you pick one useful place to try Rokko and set clear rules before the first test."
  />

  <section class="section resource-list">
    <div class="container--content">
      <div class="resource-list__heading">
        <p class="eyebrow">Three things to settle first</p>
        <p class="deck">Keep it simple. Pick the question. Pick who makes the call. Pick the result you can check.</p>
      </div>
      <div class="grid-3">
        {guides.map((guide) => (
          <article class="numbered-card">
            <span class="numbered-card__number">{guide.number}</span>
            <h2>{guide.title}</h2>
            <p>{guide.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--dark worksheet">
    <div class="container--content worksheet__grid">
      <div>
        <p class="eyebrow">Five lines to bring to a demo</p>
        <h2>Write this down before we talk.</h2>
      </div>
      <ol>
        <li><span>Question</span><p>What do you need to know or decide?</p></li>
        <li><span>Details</span><p>Which job record, note, or schedule has the answer?</p></li>
        <li><span>Next step</span><p>What should Rokko get ready for you?</p></li>
        <li><span>Approval</span><p>Who says yes, and when should the crew step in?</p></li>
        <li><span>Result</span><p>How will you know the work is done right?</p></li>
      </ol>
    </div>
  </section>

  <FinalCta title="Bring the five lines. We’ll build the demo around them." />
</BaseLayout>

<style>
  .resource-list__heading { display: grid; gap: 1rem; margin-bottom: clamp(3rem, 6vw, 6rem); }
  .resource-list .numbered-card { min-height: 23rem; }
  .resource-list h2 { font-size: clamp(1.6rem, 2.6vw, 2.5rem); }
  .worksheet__grid { display: grid; gap: clamp(3rem, 8vw, 8rem); }
  .worksheet h2 { max-width: 11ch; }
  .worksheet ol { margin: 0; padding: 0; border-top: 1px solid rgb(252 251 247 / 0.2); list-style: none; }
  .worksheet li { display: grid; grid-template-columns: 6rem 1fr; gap: 1rem; padding-block: 1.25rem; border-bottom: 1px solid rgb(252 251 247 / 0.2); }
  .worksheet span { color: var(--grk-success); font-family: var(--grk-font-mono); font-size: 0.7rem; text-transform: uppercase; }
  .worksheet p { margin: 0; color: rgb(252 251 247 / 0.7); }
  @media (min-width: 48rem) {
    .resource-list__heading { grid-template-columns: 1fr 1fr; align-items: end; }
    .worksheet__grid { grid-template-columns: 0.85fr 1.15fr; }
  }
</style>
