---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import DraftNotice from '../components/DraftNotice.astro';
---

<BaseLayout
  title="Rokko and your business data"
  description="See the security rules Rokko is being built around: tight access, owner approval for big changes, and a clear record of what happened."
  noindex
>
  <PageHero
    eyebrow="Your data"
    title="Your business data should stay your business."
    deck="Worried a stolen login could expose your customer list or let someone change a job? We are building Rokko to keep access tight, hold big moves for the right person, and show you what happened."
    tone="dark"
  />

  <section class="section security-principles">
    <div class="container--content">
      <DraftNotice title="We won’t fake a security badge">Our hosting, data handling, and independent review details are still being checked. Until the paperwork is approved, we won’t post a badge or make a promise we can’t prove.</DraftNotice>
      <div class="grid-3 security-principles__grid">
        <article class="numbered-card"><span class="numbered-card__number">01</span><h2>Keep access tight</h2><p>Each person should see only the jobs and customer details they need to do their work.</p></article>
        <article class="numbered-card"><span class="numbered-card__number">02</span><h2>Big changes wait for you</h2><p>The right person should say yes before Rokko changes a job, schedule, or other important record.</p></article>
        <article class="numbered-card"><span class="numbered-card__number">03</span><h2>See what happened</h2><p>If something looks wrong, you should be able to see what changed, when it changed, and who approved it.</p></article>
      </div>
    </div>
  </section>

  <section class="section section--dark review-list">
    <div class="container--content review-list__grid">
      <div><p class="eyebrow">The facts we’re still checking</p><h2>Before we ask for your trust, we need clear answers.</h2></div>
      <ul>
        <li>Where your data is kept and how it stays separate from other customers</li>
        <li>How logins, team access, and approvals work</li>
        <li>How long information is kept and how it is erased</li>
        <li>What record we keep and what happens if there is a security problem</li>
        <li>Which independent checks or certificates truly apply</li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .security-principles__grid { margin-top: clamp(3rem, 6vw, 6rem); }
  .security-principles h2 { font-size: clamp(1.6rem, 2.5vw, 2.4rem); }
  .review-list__grid { display: grid; gap: clamp(3rem, 8vw, 8rem); }
  .review-list h2 { max-width: 12ch; }
  .review-list ul { margin: 0; padding: 0; border-top: 1px solid rgb(252 251 247 / 0.2); list-style: none; }
  .review-list li { padding-block: 1.25rem; color: rgb(252 251 247 / 0.72); border-bottom: 1px solid rgb(252 251 247 / 0.2); }
  @media (min-width: 48rem) { .review-list__grid { grid-template-columns: 0.9fr 1.1fr; } }
</style>
