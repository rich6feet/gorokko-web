---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import FinalCta from '../../components/FinalCta.astro';
import { useCases, type UseCase } from '../../content/useCases';

export function getStaticPaths() {
  return useCases.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

interface Props { item: UseCase }
const { item } = Astro.props;
---

<BaseLayout
  title={`${item.title} with Rokko — Home-service example`}
  description={item.short}
>
  <PageHero eyebrow={`Example ${item.number}`} title={item.title} deck={item.short} tone="moss" />

  <section class="section operating-question">
    <div class="container--content operating-question__grid">
      <div>
        <p class="eyebrow">The question</p>
        <blockquote>“{item.question}”</blockquote>
      </div>
      <div>
        <p class="deck">This is an example of how the work could flow. We confirm the tools, messages, and changes Rokko can handle before any test starts.</p>
      </div>
    </div>
  </section>

  <section class="section section--paper friction">
    <div class="container--content">
      <p class="eyebrow">Why this gets messy</p>
      <div class="grid-3">
        {item.friction.map((point, index) => (
          <article class="numbered-card">
            <span class="numbered-card__number">0{index + 1}</span>
            <p>{point}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--dark workflow">
    <div class="container--content">
      <div class="workflow__heading">
        <div><p class="eyebrow">A simple path</p><h2>From stuck work to a clear next step.</h2></div>
        <p class="deck">Before a test starts, we agree on which details Rokko may check, what it may prepare, and who says yes.</p>
      </div>
      <ol>
        {item.flow.map((step, index) => (
          <li><span>0{index + 1}</span><strong>{step.label}</strong><p>{step.body}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section proof-standard">
    <div class="container--content proof-standard__grid">
      <div><p class="eyebrow">Know what good looks like</p><h2>Set the goal before the test starts.</h2></div>
      <p class="deck">{item.proof}</p>
    </div>
  </section>

  <FinalCta
    eyebrow={`Try ${item.title.toLowerCase()}`}
    title="Build the demo around the real headache."
    body="Bring the question, the job details, the person who says yes, and the result your team wants."
  />
</BaseLayout>

<style>
  .operating-question__grid,
  .workflow__heading,
  .proof-standard__grid { display: grid; gap: clamp(2.5rem, 7vw, 7rem); align-items: end; }
  .operating-question blockquote { max-width: 18ch; margin: 0; font-family: var(--grk-font-serif); font-size: clamp(2.25rem, 5vw, 4.5rem); line-height: 1.02; }
  .friction .numbered-card { min-height: 18rem; }
  .friction .numbered-card p { color: var(--grk-ink); font-size: 1.08rem; }
  .workflow__heading { margin-bottom: clamp(3rem, 6vw, 6rem); }
  .workflow h2 { max-width: 12ch; }
  .workflow ol { display: grid; margin: 0; padding: 0; border-top: 1px solid rgb(252 251 247 / 0.2); list-style: none; }
  .workflow li { display: grid; grid-template-columns: 3rem 1fr; padding-block: 1.5rem; border-bottom: 1px solid rgb(252 251 247 / 0.2); }
  .workflow li span { color: var(--grk-success); font-family: var(--grk-font-mono); font-size: 0.72rem; }
  .workflow li p { grid-column: 2; margin: 0.5rem 0 0; color: rgb(252 251 247 / 0.68); }
  .proof-standard h2 { max-width: 11ch; }
  @media (min-width: 48rem) {
    .operating-question__grid { grid-template-columns: 1.15fr 0.85fr; }
    .workflow__heading { grid-template-columns: 1.1fr 0.9fr; }
    .workflow ol { grid-template-columns: repeat(4, 1fr); }
    .workflow li { grid-template-columns: 1fr; min-height: 17rem; padding: 1.5rem; border-right: 1px solid rgb(252 251 247 / 0.2); }
    .workflow li:last-child { border-right: 0; }
    .workflow li strong { margin-top: 4rem; }
    .workflow li p { grid-column: 1; }
    .proof-standard__grid { grid-template-columns: 1fr 1fr; }
  }
</style>
